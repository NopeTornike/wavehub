# WaveHub PRODUCTION environment — copy to `.env` next to docker-compose.yml on the server:
#
#     cp .env.production.example .env && chmod 600 .env
#
# Docker Compose reads `.env` automatically. NEVER commit the filled-in file (it is gitignored).
# Every variable the stack understands is listed here. Lines marked REQUIRED make `docker compose
# up` refuse to start when empty; the backend additionally refuses to boot in production if a
# secret is weak or a dev placeholder (backend/src/config/production-config.ts). Generate secrets
# with `openssl rand -hex 32` — a different value for each one.

# ---------------------------------------------------------------------------------------------
# Domain / TLS (Caddy)
# ---------------------------------------------------------------------------------------------
# REQUIRED. The public hostname, no scheme. Its DNS A/AAAA record must point at this server BEFORE
# the first `docker compose up`, or Let's Encrypt issuance fails (and can rate-limit you).
DOMAIN=wavehub.example.com
# REQUIRED. Let's Encrypt sends certificate-expiry warnings here.
ACME_EMAIL=ops@example.com

# ---------------------------------------------------------------------------------------------
# Public URLs — single-domain layout (frontend at /, API under /api)
# ---------------------------------------------------------------------------------------------
# REQUIRED, must be https:// in production. Used in verification/reset email links and to validate
# post-payment redirect targets.
FRONTEND_URL=https://wavehub.example.com
# REQUIRED. The backend's public base URL INCLUDING the /api prefix. Builds the BOG callback URL
# (BACKEND_PUBLIC_URL/payments/bog/callback) and locally-stored upload URLs.
BACKEND_PUBLIC_URL=https://wavehub.example.com/api
# REQUIRED. Comma-separated allowed browser origins. Same-origin deployments never exercise CORS,
# but the backend insists it is set (and https) so a misconfiguration can't silently open it up.
CORS_ORIGIN=https://wavehub.example.com
# REQUIRED. Baked into the frontend bundle at BUILD time — after changing it run
# `docker compose build frontend && docker compose up -d`.
NEXT_PUBLIC_API_URL=https://wavehub.example.com/api

# ---------------------------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------------------------
POSTGRES_USER=wavehub
POSTGRES_DB=wavehubdb
# REQUIRED. >= 12 chars, not a dev default. `openssl rand -hex 24`. Only used on the private compose
# network. NOTE: Postgres reads this only when it first initialises the data volume — changing it
# later does NOT change the existing database's password (see docs/DEPLOY.md, "Rotating secrets").
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_24
# Set to false to stop the backend container running migrations at every start (only sensible if
# you run several backend replicas and migrate from exactly one).
RUN_MIGRATIONS=true

# ---------------------------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------------------------
# REQUIRED. Signs session cookies (JWT, HS256). >= 32 chars. Rotating it logs every user out.
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
# REQUIRED. 64 hex chars (32 bytes, AES-256-GCM). Encrypts Steam/digital-key inventory at rest.
# LOSING OR CHANGING THIS MAKES EVERY STORED KEY PERMANENTLY UNREADABLE — back it up separately
# from the database (password manager), and never rotate it without a re-encryption migration.
KEY_ENCRYPTION_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ---------------------------------------------------------------------------------------------
# Email (verification + password reset). Users cannot activate accounts without working email.
# ---------------------------------------------------------------------------------------------
# REQUIRED. `resend` (Resend HTTP API, no SDK) or `console` (does NOT send; logs only recipient
# domain + subject — use only for smoke tests, real signups will be stuck unverified).
EMAIL_PROVIDER=resend
# Required when EMAIL_PROVIDER=resend. Create at resend.com after verifying your sending domain.
RESEND_API_KEY=
# Required when EMAIL_PROVIDER=resend. Must be on a domain verified in Resend.
EMAIL_FROM="WaveHub <no-reply@wavehub.example.com>"

# ---------------------------------------------------------------------------------------------
# File uploads (listing images, delivery files, dispute evidence, tournament covers)
# ---------------------------------------------------------------------------------------------
# `local` (default): files live in the `uploads` Docker volume on this server and are served by the
# backend at /api/uploads/*. Fine for one server; back the volume up (scripts/backup.sh does).
# `s3`: any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, Hetzner, MinIO) — files
# survive server rebuilds and can be served from a CDN. Reads are PUBLIC via S3_PUBLIC_BASE_URL.
STORAGE_DRIVER=local
# --- only when STORAGE_DRIVER=s3 ---
# Endpoint URL. R2: https://<accountid>.r2.cloudflarestorage.com  B2: https://s3.<region>.backblazeb2.com
# Leave empty for AWS (defaults to https://s3.<S3_REGION>.amazonaws.com).
S3_ENDPOINT=
# AWS region (e.g. eu-central-1); `auto` for Cloudflare R2.
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public https base URL the browser loads files from (bucket public URL or CDN/custom domain),
# no trailing slash. Objects are written under `uploads/<uuid>.<ext>` beneath it.
S3_PUBLIC_BASE_URL=
# true = https://endpoint/bucket/key (R2, B2, MinIO, most providers); false = virtual-hosted
# https://bucket.endpoint/key (AWS default for new buckets).
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------------------------
# Bank of Georgia (WaveCoin top-ups + subscriptions). Optional until the owner supplies
# PRODUCTION credentials — /payments/bog/* and subscription checkout return 503 without them.
# ---------------------------------------------------------------------------------------------
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=
# Only to point at a BOG sandbox / non-default environment, or if BOG rotates its callback-signing
# public key (see backend/src/payments/CLAUDE.md). Leave empty for the production defaults.
BOG_OAUTH_URL=
BOG_ORDERS_URL=
BOG_CALLBACK_PUBLIC_KEY=

# ---------------------------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------------------------
# Structured, PII-free access log (method, id-collapsed path, status, duration, request id).
# Set to `off` to silence it.
REQUEST_LOG=on

# ---------------------------------------------------------------------------------------------
# Set by docker-compose.yml itself — do not put these in .env
# ---------------------------------------------------------------------------------------------
# NODE_ENV=production, PORT=4000, TRUST_PROXY=1 (one proxy hop: Caddy), TYPEORM_SYNC=false,
# DATABASE_HOST/PORT/USER/PASSWORD/NAME (derived from POSTGRES_*), UPLOADS_DIR=/data/uploads.
