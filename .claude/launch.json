{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wavehub-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "frontend"
      ],
      "port": 3000
    },
    {
      "name": "wavehub-backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "backend:dev"
      ],
      "port": 4000
    },
    {
      "name": "wavehub-frontend-prod",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npm run build -w frontend && npm run start -w frontend -- -p 3000"
      ],
      "port": 3000
    }
  ]
}