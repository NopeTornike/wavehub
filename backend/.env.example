DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=wavehub
DATABASE_PASSWORD=wavehubpass
DATABASE_NAME=wavehubdb
PORT=4000
CORS_ORIGIN=http://localhost:3000
TYPEORM_SYNC=true
NODE_ENV=development

# Required in production (throws at boot if unset there). Falls back to an insecure dev-only
# default locally so `npm run start:dev` and CI don't need it configured — see auth.module.ts.
JWT_SECRET=

# Used to build links in verification/password-reset emails, and to validate BOG checkout redirect
# URLs (successUrl/failUrl) are on our own frontend, not an attacker-controlled one.
FRONTEND_URL=http://localhost:3000

# Only set this if actually deployed behind a real reverse proxy/load balancer that sets
# X-Forwarded-For. Setting it without one present lets any client spoof its own IP and silently
# defeats rate limiting. Leave unset for local dev and for any deployment without such a proxy.
# TRUST_PROXY=1

# This backend's own publicly-reachable base URL — used to build the BOG callback URL
# (${BACKEND_PUBLIC_URL}/payments/bog/callback). Must be HTTPS and reachable from BOG's servers in
# any real deployment (a local dev value won't actually receive callbacks unless tunneled).
BACKEND_PUBLIC_URL=http://localhost:4000

# Bank of Georgia e-commerce API credentials (WaveCoin top-up). Required for /payments/bog/* to
# work; that endpoint returns 503 if these are unset. See backend/src/payments/CLAUDE.md.
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=

# Encrypts Steam-key (or similar) secrets at rest for backend/src/listings/'s DigitalKey listing
# type — required in production (throws at boot if unset there), falls back to a fixed insecure
# dev-only key locally (loudly warned) same as JWT_SECRET above. Must be a 64-character hex string
# (32 bytes, for AES-256) — generate one with `openssl rand -hex 32`. See
# backend/src/listings/key-encryption.util.ts.
KEY_ENCRYPTION_SECRET=
# Optional overrides — only set these to point at a BOG sandbox/non-default environment, or if BOG
# rotates the callback-signing public key (see bog-signature.util.ts for the current default).
# BOG_OAUTH_URL=
# BOG_ORDERS_URL=
# BOG_CALLBACK_PUBLIC_KEY=

# --- Added by the launch-readiness pass (see docs/DEPLOY.md and /.env.production.example) ---

# Transactional email. `console` (default when unset outside production) just logs; `resend` sends
# through Resend's HTTP API and needs RESEND_API_KEY + EMAIL_FROM. In production this must be set
# explicitly.
# EMAIL_PROVIDER=console
# RESEND_API_KEY=
# EMAIL_FROM="WaveHub <no-reply@example.com>"

# Upload storage. `local` (default) writes to UPLOADS_DIR (default ./uploads) and is served at
# /uploads; `s3` uses any S3-compatible bucket (see .env.production.example for each variable).
# STORAGE_DRIVER=local
# UPLOADS_DIR=
# S3_ENDPOINT= S3_REGION= S3_BUCKET= S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY= S3_PUBLIC_BASE_URL= S3_FORCE_PATH_STYLE=true

# Set to `off` to silence the one-line-per-request JSON access log (method, path, status, ms — no PII).
# REQUEST_LOG=on
