# Generate a unique value with at least 32 characters before starting Docker.
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret-value

# Production defaults. For plain HTTP local development only, set COOKIE_SECURE=false.
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
CORS_ORIGIN=http://localhost:3000

# If the frontend and API are on different sites, use HTTPS and set:
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none
